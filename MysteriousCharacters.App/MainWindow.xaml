<Window x:Class="MysteriousCharacters.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="隐文匣 - 设置"
        Icon="Resources/AppIcon.ico"
        Width="700"
        Height="760"
        MinWidth="640"
        MinHeight="680"
        Background="#F4FBF7"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="MintDark" Color="#287553" />
        <SolidColorBrush x:Key="Mint" Color="#4FAE7C" />
        <SolidColorBrush x:Key="MintLight" Color="#E7F7EE" />
        <SolidColorBrush x:Key="TextPrimary" Color="#244436" />
        <SolidColorBrush x:Key="TextMuted" Color="#698075" />
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9ECE1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MintDark}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,4,14,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="#C7E2D3" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="BorderBrush" Value="#C7E2D3" />
            <Setter Property="Background" Value="#FBFEFC" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Mint}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3D9668" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="22,17" Background="#DFF5E8" BorderBrush="#C8E8D6" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="50"
                        Height="50"
                        Background="{StaticResource Mint}"
                        CornerRadius="14">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Text="匣" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                    <TextBlock Foreground="{StaticResource MintDark}"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Text="隐文匣" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{StaticResource TextMuted}"
                               Text="选中文字，按下快捷键，在当前输入框中完成本地文字变换。" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,8">
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="运行状态" />
                        <CheckBox x:Name="EnabledCheckBox" Content="开启快捷键转换" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{StaticResource TextMuted}"
                                   Text="程序驻留在系统托盘中。关闭设置窗口不会退出程序。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="快捷键" />
                        <WrapPanel>
                            <CheckBox x:Name="CtrlCheckBox" Content="Ctrl" />
                            <CheckBox x:Name="AltCheckBox" Content="Alt" />
                            <CheckBox x:Name="ShiftCheckBox" Content="Shift" />
                            <CheckBox x:Name="WinCheckBox" Content="Win" />
                            <ComboBox x:Name="HotkeyKeyComboBox" Width="106" Margin="4,0,0,0" />
                        </WrapPanel>
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource TextMuted}"
                                   Text="默认快捷键为 Ctrl + Alt + E。保存时会检查快捷键冲突。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}" Background="#ECF9F1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="智能混合策略" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="系统内置 3500 个常用字规则并固定使用 100% 替换：优先增删偏旁，其次选择同音字和形近字。无法可靠转换的非常用字会保持原样，输出始终是正常可显示的汉字。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="剪贴板与提示" />
                        <CheckBox x:Name="RestoreClipboardCheckBox"
                                  Content="粘贴完成后尽量恢复原剪贴板内容" />
                        <CheckBox x:Name="ShowNotificationsCheckBox"
                                  Content="失败或跳过时显示轻量托盘提示" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="黑名单应用" />
                        <TextBlock Margin="0,0,0,7"
                                   Foreground="{StaticResource TextMuted}"
                                   Text="每行填写一个进程名，可省略 .exe。命中时快捷键会静默跳过。" />
                        <TextBox x:Name="BlacklistTextBox"
                                 Height="102"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="自定义词典" />
                        <TextBlock x:Name="DictionaryPathTextBlock"
                                   Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap" />
                        <WrapPanel Margin="0,9,0,0">
                            <Button Click="ImportDictionaryButton_OnClick" Content="导入 JSON 词典" />
                            <Button Click="ReloadDictionaryButton_OnClick" Content="重新加载" />
                            <Button Click="OpenDataFolderButton_OnClick" Content="打开数据目录" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="20,12"
                Background="White"
                BorderBrush="#D9ECE1"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}"
                           Text="准备就绪" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Click="SaveButton_OnClick" Content="保存设置" />
                    <Button Margin="0" Click="HideButton_OnClick" Content="隐藏到托盘" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
