<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MysteriousCharacters</AssemblyName>
    <RootNamespace>MysteriousCharacters.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\default-dictionary.json"
                      LogicalName="default-dictionary.json" />
    <EmbeddedResource Include="Resources\radical-families.json"
                      LogicalName="radical-families.json" />
    <EmbeddedResource Include="Resources\common-character-rules.json"
                      LogicalName="common-character-rules.json" />
    <Resource Include="Resources\AppIcon.ico" />
  </ItemGroup>

</Project>
